# Copy to .env for local compose / panel
DATABASE_URL=postgresql://primefleet:primefleet@127.0.0.1:5433/primefleet_cloud
# Required in production: 32+ random chars (never use the placeholders below)
AUTH_SECRET=change-me-local-auth-secret-32chars
# Optional fallback — prefer Panel → WhatsApp (saved in DB)
OPENWA_BASE_URL=http://127.0.0.1:2785
OPENWA_API_KEY=
OPENWA_SESSION_ID=

# Hosted WA provisioner: mock | shared (shared = SSH bootstrap on existing VPS)
# WA_PROVIDER=mock
# WA_VPS_HOST=193.182.128.85
# WA_VPS_USER=admin
# WA_VPS_SSH_KEY=
# WA_OPENWA_PUBLIC_URL=http://193.182.128.85:2785
# WA_BOOTSTRAP_REMOTE=/home/admin/scripts/vps/bootstrap-openwa.sh
PANEL_PUBLIC_URL=http://localhost:3040
# Set COOKIE_SECURE=true when PANEL_PUBLIC_URL is https
# COOKIE_SECURE=true
SEED_ADMIN_EMAIL=admin@primefleet.local
SEED_ADMIN_PASSWORD=admin12345
# Production seed never overwrites password unless:
# SEED_RESET_ADMIN_PASSWORD=1

# Envato Market (Sprint 4) — leave empty for local MOCK- purchase codes
ENVATO_PERSONAL_TOKEN=
ENVATO_ITEM_ID=
ALLOW_MOCK_ENVATO=1
ALLOW_MOCK_CHECKOUT=1

# Stripe Hosted WA subscriptions (or set in panel → Billing)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID_MONTHLY=price_…   # $15 / month recurring
# STRIPE_PRICE_ID_YEARLY=price_…    # $120 / year ($10/mo)
# STRIPE_CURRENCY=usd
# Production: keep mocks off. Never set FORCE_MOCK_IN_PROD unless emergency QA.
# FORCE_MOCK_IN_PROD=0

# Public plugin-key bootstrap via /api/v1/sites/bootstrap (no WA trial; OFF in production by default)
# ALLOW_PUBLIC_BOOTSTRAP=1

# Comma-separated hosts allowed in return_to (plus bound site + panel host)
# RETURN_TO_ALLOWLIST=example.com,mysite.test

# WhatsApp send caps
WA_TEXT_MAX_CHARS=4096
WA_DAILY_QUOTA=500

# Unpaid Hosted WA: stop sends immediately; power-off after grace (not destroy)
WA_GRACE_DAYS=3
# Cron: GET/POST /api/cron/grace-power-off  Authorization: Bearer $CRON_SECRET
CRON_SECRET=change-me-cron-secret
